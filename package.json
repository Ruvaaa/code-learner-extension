{
  "name": "code-learner",
  "displayName": "Code Learner",
  "description": "An absolute beginner's programming assistant that explains highlighted code snippets in plain, jargon-free English directly inside your editor.",
  "publisher": "Ruvaaaaaa",
  "icon": "icon.png",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruvaaa/code-learner-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Ruvaaa/code-learner-extension/issues"
  },
  "homepage": "https://github.com/Ruvaaa/code-learner-extension#readme",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education",
    "Machine Learning",
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "code explanation",
    "explain code",
    "flowchart",
    "beginner",
    "conceptual model",
    "mermaid",
    "tutor",
    "learning",
    "diagram",
    "python",
    "javascript",
    "typescript",
    "code assistant",
    "visualizer"
  ],
  "activationEvents": [
    "onView:codeLearner.conceptualModelView",
    "onCommand:code-learner.generateConceptualModel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-learner-container",
          "title": "Code Learner",
          "icon": "$(symbol-structure)"
        }
      ]
    },
    "views": {
      "code-learner-container": [
        {
          "type": "webview",
          "id": "codeLearner.conceptualModelView",
          "name": "Let's Learn Code Together!"
        }
      ]
    },
    "commands": [
      {
        "command": "code-learner.explainCode",
        "title": "Code Learner: Explain Selected Code"
      },
      {
        "command": "code-learner.generateConceptualModel",
        "title": "Code Learner: Generate File Conceptual Model"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "code-learner.explainCode",
          "when": "editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "code-learner.generateConceptualModel",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Code Learner",
      "properties": {
        "codeLearner.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your API key for Groq (gsk_...) or Hugging Face (hf_...)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}